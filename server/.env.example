# NinePlus 本地门户账号（部署前必须修改）
NINEPLUS_PORTAL_USERNAME=admin
NINEPLUS_PORTAL_PASSWORD=请替换为高强度密码
# 可选：开启后，iOS App（含 APNs 设备 Token 上报）必须携带 Authorization: Bearer <Token>
NINEPLUS_APP_BEARER_TOKEN=

# 服务器时区与九号云设备标识；通常保持默认即可
NINEPLUS_COOKIE_SECURE=auto
NINEPLUS_SESSION_TTL=2592000
NINEPLUS_CLI_TIMEOUT=45
NINEPLUS_DEVICE_ID=

# 可选：配置后服务器会在每次 App 刷新车况、检测到充电/骑行/报警变化时通过 APNs 下发通知。
# .p8 私钥必须仅放在服务器私有持久化路径，绝不能提交到 Git。
NINEPLUS_APNS_KEY_ID=
NINEPLUS_APNS_TEAM_ID=
NINEPLUS_APNS_AUTH_KEY_PATH=/run/nineplus/sessions/AuthKey_XXXXXXXXXX.p8
NINEPLUS_APNS_REQUEST_TIMEOUT=10
