# 飞牛端口；容器内部固定使用 8765
NINEPLUS_PORT=8765

# NinePlus 本地门户账号（部署前必须修改）
NINEPLUS_PORTAL_USERNAME=admin
NINEPLUS_PORTAL_PASSWORD=请替换为高强度密码
# 可选：开启后，iOS App（含 APNs 设备 Token 上报）必须携带 Authorization: Bearer <Token>
NINEPLUS_APP_BEARER_TOKEN=

# 服务器时区与九号云设备标识；通常保持默认即可
TZ=Asia/Shanghai
NINEPLUS_COOKIE_SECURE=auto
NINEPLUS_SESSION_TTL=2592000
NINEPLUS_CLI_TIMEOUT=45
NINEPLUS_DEVICE_ID=

# 九号云读取缓存（秒）：缩短可提高实时性，但会增加 ninecli/九号云请求并拖慢打开速度。
NINEPLUS_CACHE_TTL_VEHICLES=30
NINEPLUS_CACHE_TTL_STATUS=8
NINEPLUS_CACHE_TTL_BATTERY=15
NINEPLUS_CACHE_TTL_TRAVEL=300
# 首页性能：状态接口已包含电量百分比，默认不等待电池诊断详情；网页会在首页显示后只补拉当前车辆。
NINEPLUS_DASHBOARD_INCLUDE_BATTERY=0
# 只读 ninecli 请求并发数；读取使用临时配置副本，不与控制/登录共用写锁。
NINEPLUS_READ_CONCURRENCY=4
# 首页快照：30 秒内直接返回，过期后先返回旧快照并后台刷新；最多容忍 5 分钟旧数据。
NINEPLUS_DASHBOARD_SNAPSHOT_TTL=30
NINEPLUS_DASHBOARD_STALE_TTL=300

# 可选：配置后服务器会在每次 App 刷新车况、检测到充电/骑行/报警变化时通过 APNs 下发通知。
# .p8 私钥必须仅放在服务器私有持久化路径，绝不能提交到 Git。
NINEPLUS_APNS_KEY_ID=
NINEPLUS_APNS_TEAM_ID=
NINEPLUS_APNS_AUTH_KEY_PATH=/run/nineplus/sessions/AuthKey_XXXXXXXXXX.p8
NINEPLUS_APNS_REQUEST_TIMEOUT=10

# 可选：Cloudflare Tunnel Connector Token。仅在启用 compose 的 cloudflare profile 时填写。
# 在 Cloudflare Zero Trust 的 Tunnel / Connectors / Docker 页面复制。
CLOUDFLARE_TUNNEL_TOKEN=
